body{
    background:#f5f7fa;
    color:#222;
    font-family:Arial,sans-serif;
}

header{
    background:white;
    padding:18px 24px;
    border-bottom:1px solid #ddd;

    display:flex;
    justify-content:space-between;
    align-items:center;
    flex-wrap:wrap;
}

header h1{
    margin:0;
    font-size:24px;
}

nav{
    display:flex;
    gap:18px;
}

nav a{
    text-decoration:none;
    color:#444;
    font-weight:bold;
}

nav a:hover{
    color:#2b7cff;
}

.card{

    background:white;

    border-radius:16px;

    padding:24px;

    text-align:center;

    box-shadow:0 3px 12px rgba(0,0,0,.08);

    transition:transform .15s ease;

}

.card h3{

    margin:0;

    font-size:16px;

    font-weight:600;

    color:#666;

}

.card p{

    margin:16px 0 0;

    font-size:42px;

    font-weight:700;

    color:#222;

}

.card:hover{

    transform:translateY(-3px);

}

#health-card{

    border-left:8px solid #16a34a;

    margin-bottom:24px;

}

#health-title{

    margin-top:0;

    color:#16a34a;

}

.dashboard{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));

    gap:20px;

    margin-bottom:30px;

}

.dashboard-images{

    display:grid;

    grid-template-columns:2fr 1fr;

    gap:20px;

    margin-bottom:30px;

}

.dashboard-images .card{

    padding:16px;

}

.dashboard-images img{

    width:100%;

    height:280px;

    object-fit:cover;

    border-radius:12px;

    background:#eee;

}


button{
    padding:10px 18px;
    border:none;
    border-radius:8px;
    cursor:pointer;
    background:#2b7cff;
    color:white;
    font-size:15px;
}

button:hover{
    background:#1f63d5;
}

.badge{

    display:inline-block;

    padding:6px 12px;

    border-radius:20px;

    font-size:14px;

    font-weight:600;

}

.badge.still{

    background:#dbeafe;

    color:#1d4ed8;

}

.badge.motion{

    background:#fef3c7;

    color:#b45309;

}

.badge.clip{

    background:#fee2e2;

    color:#b91c1c;

}

.card{

    background:white;

    border-radius:16px;

    overflow:hidden;

    box-shadow:0 2px 10px rgba(0,0,0,.08);

}

.card img{

    display:block;

    width:100%;

    aspect-ratio:4/3;

    object-fit:cover;

}

.gallery-toolbar{

    position:sticky;

    top:0;

    z-index:100;

    background:white;

    padding:15px;

    border-radius:12px;

    box-shadow:0 2px 8px rgba(0,0,0,.08);

    margin-bottom:20px;

}


.gallery-image{
    cursor:pointer;
}

.lightbox{
    display:none;
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.88);
    justify-content:center;
    align-items:center;
    z-index:9999;
}

.lightbox img{
    max-width:95vw;
    max-height:95vh;
    object-fit:contain;
    border-radius:12px;
}

.lightbox-close{
    position:absolute;
    top:20px;
    right:35px;
    color:white;
    font-size:46px;
    cursor:pointer;
    user-select:none;
}

.video-thumb{

    position:relative;

    display:block;

}

.video-thumb img{

    width:100%;
    display:block;

}

.play-icon{

    position:absolute;

    left:50%;
    top:50%;

    transform:translate(-50%,-50%);

    font-size:56px;

    color:white;

    background:rgba(0,0,0,.45);

    width:80px;
    height:80px;

    border-radius:50%;

    display:flex;

    justify-content:center;

    align-items:center;

    pointer-events:none;

    transition:.2s;

}

.video-thumb:hover .play-icon{

    transform:translate(-50%,-50%) scale(1.1);

}


@media (max-width:700px){

    .gallery-toolbar{

        display:flex;

        flex-direction:column;

        gap:10px;

    }

    .gallery-toolbar button{

        width:100%;

    }

}

@media (max-width:800px){

    .dashboard-images{

        grid-template-columns:1fr;

    }

    .card p{

        font-size:34px;

    }

}

.card-info{

    padding:14px 16px;

}

.label{

    font-size:1.05rem;

    font-weight:700;

    margin-bottom:6px;

}

.time{

    color:#666;

    font-size:.9rem;

    margin-bottom:10px;

}

.event-meta{

    color:#2f6d3d;

    font-size:.9rem;

    font-weight:600;

}

.card-footer{

    padding:0 16px 16px;

    border-top:1px solid #eee;

    margin-top:12px;

    padding-top:12px;

}

.card{

    color:#333;

}

.grid{

    display:grid;

    grid-template-columns:
        repeat(auto-fit,minmax(320px,1fr));

    gap:24px;

    margin-top:20px;

}

.video-thumb{

    position:relative;

    overflow:hidden;

}

.video-thumb a{

    display:block;

}

.video-thumb::after {

    content: "▶";

    position: absolute;

    top: 50%;
    left: 50%;

    transform: translate(-50%, -50%);

    font-size: 48px;

    color: white;

    text-shadow: 0 0 8px black;

    pointer-events: none;

}
